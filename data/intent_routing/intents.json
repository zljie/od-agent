[
  {
    "id": "intent_order_query",
    "name": "order_query",
    "display_name": "订单查询",
    "description": "用户希望查询订单状态、发货进度或物流位置",
    "status": "enabled",
    "priority": 90,
    "domain": "order_service",
    "route_type": "skill",
    "route_target": "order_lookup_skill",
    "fallback_action": "ask_missing_slot",
    "failure_action": "human_handoff",
    "semantic_enabled": true,
    "keyword_boost_enabled": true,
    "regex_enabled": false,
    "include_keywords": ["订单", "发货", "物流", "快递", "到哪", "状态", "查询", "什么时候"],
    "exclude_keywords": ["退货", "退款", "投诉", "转人工"],
    "positive_examples": [
      "我的订单到哪了？",
      "帮我查一下订单状态",
      "订单什么时候发货？",
      "我买的东西还没到",
      "订单已经付款了，什么时候处理？",
      "查一下快递到哪了",
      "我的包裹发出去了吗"
    ],
    "negative_examples": [
      "我要退货",
      "我要退款",
      "我要改收货地址",
      "这个商品多少钱",
      "转人工客服"
    ],
    "edge_examples": [
      "我的快递怎么还没到？",
      "为什么还没有物流信息？",
      "订单发错了怎么办？"
    ],
    "slots": [
      {
        "id": "slot_order_id",
        "slot_name": "order_id",
        "required": true,
        "required_mode": "one_of",
        "group": "order_id_or_phone",
        "source": ["user_input", "session"],
        "missing_action": "ask",
        "ask_template": "请提供您的订单号或手机号，我可以帮您查询订单状态。"
      },
      {
        "id": "slot_phone",
        "slot_name": "phone",
        "required": true,
        "required_mode": "one_of",
        "group": "order_id_or_phone",
        "source": ["user_input", "profile"],
        "missing_action": "ask",
        "ask_template": "请提供您的手机号，我可以帮您查询订单。"
      }
    ],
    "test_cases": [
      {
        "id": "tc_order_001",
        "input": "我的订单到哪了？",
        "expected_intent": "order_query",
        "expected_route_target": "order_lookup_skill",
        "expected_action": "ask_missing_slot",
        "expected_missing_slots": ["order_id", "phone"],
        "status": "passed"
      },
      {
        "id": "tc_order_002",
        "input": "帮我查一下订单状态",
        "expected_intent": "order_query",
        "expected_route_target": "order_lookup_skill",
        "expected_action": "ask_missing_slot",
        "status": "passed"
      }
    ],
    "conflict": false,
    "test_failed": false,
    "created_at": "2026-06-01T10:00:00",
    "updated_at": "2026-06-01T10:00:00"
