  "integration_tests": [
    {
      "test_id": "integration_001",
      "description": "完整流程测试 - 从用户输入到查询结果",
      "user_input": "先处理上周采购类型为办公用品的采购需求",
      "steps": [
        {
          "step": 1,
          "component": "Step1Recognizer",
          "expected_output": {
            "intent": "procurement/query_with_conditions",
            "extracted_slots": {
              "time_range": {"label": "上周"},
              "pr_type": "NB",
              "material_category": "办公用品"
            }
          }
        },
        {
          "step": 2,
          "component": "Step2OntologyResolver",
          "expected_output": {
            "object_type": "purchase_requests",
            "object_label": "采购需求"
          }
        },
        {
          "step": 3,
          "component": "Step3TaskPlanner",
          "expected_output": {
            "planned_actions": [
              {
                "action_id": "analytics/find_purchase_requests_with_conditions"
              }
            ],
            "query_conditions": [
              {"field": "delivery_date", "operator": "BETWEEN"},
              {"field": "pr_type", "operator": "=", "value": "NB"},
              {"field": "material_category", "operator": "=", "value": "办公用品"}
            ]
          }
        },
        {
          "step": 4,
          "component": "ProcurementConnector",
          "expected_output": {
            "success": true,
            "data.total": "> 0"
          }
        }
      ]
    }
  ]
}
